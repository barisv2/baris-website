---
const pathname = Astro.url.pathname;
---

<header>
  <a href="/" class="site-name">Barış Gürbüzler</a>
  <nav>
    <ul>
      <li><a href="/writing" class:list={{ active: pathname.startsWith('/writing') }}>Writing</a></li>
      <li><a href="/about" class:list={{ active: pathname === '/about' || pathname === '/about/' }}>About</a></li>
    </ul>
  </nav>
</header>

<style>
  .active {
    color: var(--text);
  }
</style>
