---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<html lang="en">
  <head>
    <BaseHead 
      title="Barış Gürbüzler" 
      description="Co-founder & CEO of Hardal. Helping brands get accurate data and show up in AI answers. Barcelona." 
    />
  </head>
  <body>
    <!-- If you're reading this: hello. I appreciate the curiosity. -->
    <Header />
    <main class="animate-in">
      <p class="identity">
        Co-founder & CEO of <a href="https://usehardal.com" target="_blank" rel="noopener">Hardal</a>. 
        Helping brands get accurate data and show up in AI answers. Barcelona.
      </p>

      <section class="section">
        <h2 class="section-title">About</h2>
        <div class="about-text">
          <p>
            I'm Barış. Originally from Antalya, studied in Istanbul, now living in Barcelona with my wife Göz, our cat Kiwi, and our dog Miso.
          </p>
          <p>
            I co-founded <a href="https://usehardal.com" target="_blank" rel="noopener">Hardal</a> with <a href="https://berkay.fyi" target="_blank" rel="noopener">Berkay</a> because marketing analytics had become a mess, and weirdly hard for the marketers who relied on it most. We're fixing that: the best way for accurate data.
          </p>
          <p>
            Outside of building Hardal, I'm a curious generalist. Things I keep coming back to: sailing, surfing, tennis, plants, and the sea. Barcelona makes most of these accessible.
          </p>
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Things I believe</h2>
        <ul class="beliefs-list">
          <li>[PLACEHOLDER] Quality compounds over time</li>
          <li>[PLACEHOLDER] Small teams create better work</li>
          <li>[PLACEHOLDER] Speed without direction is motion, not progress</li>
          <li>[PLACEHOLDER] The best marketing is a great product</li>
          <li>[PLACEHOLDER] Constraints breed creativity</li>
          <li>[PLACEHOLDER] Every experience teaches something</li>
        </ul>
        <p class="placeholder-note">These are drafts for Barış to edit.</p>
      </section>

      <section class="section">
        <h2 class="section-title">Writing</h2>
        {years.map(year => (
          <div class="year-group">
            <div class="year-label">{year}</div>
            <ul class="writing-list">
              {postsByYear[Number(year)].map(post => (
                <li>
                  <a href={`/writing/${post.id.replace('.md', '')}/`}>{post.data.title}</a>
                  <span class="date">
                    {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p style="margin-top: 1rem;">
          <a href="https://www.linkedin.com/in/barisgurbuzler/" target="_blank" rel="noopener" style="font-size: 0.875rem; color: var(--muted);">
            More on LinkedIn &rarr;
          </a>
        </p>
      </section>

      <section class="section">
        <h2 class="section-title">Projects</h2>
        <ul class="projects-list">
          <li>
            <a href="https://usehardal.com" target="_blank" rel="noopener">Hardal</a>
            <span class="desc">Accurate marketing analytics. AI visibility and data accuracy for brands.</span>
          </li>
          <li>
            <a href="https://isvisible.ai" target="_blank" rel="noopener">isvisible.ai</a>
            <span class="desc">Free AI visibility checker. See if AI can find your website.</span>
          </li>
          <li>
            <a href="[PLACEHOLDER]" target="_blank" rel="noopener">[PLACEHOLDER]</a>
            <span class="desc">[PLACEHOLDER] Add other projects here.</span>
          </li>
        </ul>
      </section>

      <section class="section">
        <h2 class="section-title">Talks</h2>
        <ul class="talks-list">
          <li style="color: var(--muted); font-size: 0.9375rem; border-top: 1px solid var(--border);">
            [PLACEHOLDER] Add talks, podcasts, and conference appearances here.
          </li>
        </ul>
      </section>

      <section class="section">
        <h2 class="section-title">Contact</h2>
        <p class="contact-line">
          Find me on <a href="https://x.com/baris_v2" target="_blank" rel="noopener">X</a> or <a href="https://www.linkedin.com/in/barisgurbuzler/" target="_blank" rel="noopener">LinkedIn</a>.
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>
