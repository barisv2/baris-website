---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="About · Barış Gürbüzler" description="Originally from Turkey now in Barcelona. Building Hardal. Helping brands get accurate data & see their agentic traffic." />
  </head>
  <body>
    <Header />
    <main class="animate-in">
      <h1 class="page-title">About</h1>

      <div class="about-text" style="margin-top: 1.5rem;">
        <p>
          Originally from Turkey now in Barcelona. Building <a href="https://usehardal.com" target="_blank" rel="noopener">Hardal</a>. Helping brands get accurate data & see their agentic traffic.
        </p>
      </div>

      <div style="margin-top: 2rem;">
        <p class="contact-line">
          Find me on <a href="https://x.com/baris_v2" target="_blank" rel="noopener">X</a> or <a href="https://www.linkedin.com/in/barisgurbuzler/" target="_blank" rel="noopener">LinkedIn</a>.
        </p>
      </div>
    </main>
    <Footer />
  </body>
</html>
